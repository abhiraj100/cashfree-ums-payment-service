{
  "info": {
    "name": "Cashfree UMS Sandbox Payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "erpToken", "value": "REPLACE_WITH_LOCAL_ERP_TOKEN" },
    { "key": "invoiceId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "orderId", "value": "REPLACE_AFTER_INITIATION" },
    { "key": "idempotencyKey", "value": "postman-sandbox-order-001" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{erpToken}}", "type": "string" }] },
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" } },
    { "name": "Create invoice", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/invoices", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"erpReference\": \"SEM-{{$guid}}\",\n  \"studentReference\": \"STUDENT-001\",\n  \"customerPhone\": \"9999999999\",\n  \"amountMinor\": 10000\n}" } }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('invoiceId', pm.response.json().id);"] } }] },
    { "name": "Initiate checkout", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/payment-orders", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "body": { "mode": "raw", "raw": "{ \"invoiceId\": \"{{invoiceId}}\" }" } }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"] } }] },
    { "name": "Order status", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payment-orders/{{orderId}}" } },
    { "name": "Verify with Cashfree", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/payment-orders/{{orderId}}/verify" } },
    { "name": "Attempts", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payment-orders/{{orderId}}/attempts" } },
    { "name": "Invoice", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}" } },
    { "name": "Receipt", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/receipt" } },
    { "name": "ERP sync", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/operations/erp-sync" } },
    { "name": "Exceptions", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/operations/exceptions" } }
  ]
}
