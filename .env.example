# Local application port; choose any unused port.
PORT=3000
# Created automatically by compose.yaml, or create this user/database in local PostgreSQL.
DATABASE_URL=postgresql://ums:ums_local_password@localhost:55432/ums_payments
# Generate locally: two GUIDs or another random value of at least 24 characters.
ERP_API_TOKEN=replace-with-a-long-random-local-token
# Cashfree Merchant Dashboard -> Test environment -> Developers -> API Keys -> Payment Gateway.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree API contract version; keep this pinned until intentionally upgrading.
CASHFREE_API_VERSION=2026-01-01
# HTTPS tunnel origin pointing at PORT, for example https://name.trycloudflare.com.
# Register PUBLIC_BASE_URL/api/v1/webhooks/cashfree in Cashfree's test dashboard.
PUBLIC_BASE_URL=https://replace-with-your-public-api.example
# How often the reconciliation/outbox worker checks for work.
WORKER_INTERVAL_MS=10000
# Set true only to demonstrate ERP retry behavior.
ERP_MOCK_FAIL=false
