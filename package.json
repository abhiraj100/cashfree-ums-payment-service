{
  "name": "cashfree-ums-payment-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config frontend/vite.config.mjs --configLoader native",
    "worker:dev": "tsx watch src/worker.ts",
    "dev:all": "concurrently --kill-others --names api,web,worker --prefix-colors green,blue,yellow \"npm:dev\" \"npm:dev:web\" \"npm:worker:dev\"",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config frontend/vite.config.mjs --configLoader native",
    "build": "npm run build:api && npm run build:web",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:portable:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-portable-postgres.ps1",
    "db:portable:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-portable-postgres.ps1",
    "db:portable:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-portable-postgres.ps1",
    "setup:portable": "npm run db:portable:install && npm run db:migrate && npm run db:seed && npm run build",
    "setup:local": "npm run db:migrate && npm run db:seed && npm run build",
    "check:env": "node scripts/check-env.mjs",
    "tunnel": "tools\\cloudflared.exe tunnel --url http://localhost:3000",
    "dev:ready": "npm run db:portable:start && npm run dev:all",
    "pretest": "npm run build:api && npm run build:web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "multer": "^2.5.0",
    "js-yaml": "^5.4.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
